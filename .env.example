DATABASE_URL=postgresql://usuario:clave@localhost:5432/casku
AUTH_URL=http://localhost:3000
AUTH_SECRET=
CASKU_TEAM_ACCOUNTS=[]

# Transporte anterior. La integración con Brevo se realizará después del punto 7.
# Remitente informado: contacto@casku.cl; verificación pendiente en Brevo.
RESEND_API_KEY=
RESEND_FROM=

# Infraestructura de correos. Mantener desactivada hasta aprobar protocolo,
# calendario, plantillas e integración del proveedor. Nunca publicar estas claves.
CASKU_MAIL_AUTOMATION=0
CASKU_MAIL_POLICY_VERSION=
CASKU_MAIL_WORKER_SECRET=
# Secreto estable independiente del de autenticación: preserva la lista de supresión.
CASKU_MAIL_SUPPRESSION_SECRET=
