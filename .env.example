DATABASE_URL=postgresql://usuario:clave@localhost:5432/casku
AUTH_URL=http://localhost:3000
AUTH_SECRET=
CASKU_TEAM_ACCOUNTS=[]

# Brevo transaccional. Configuración privada; mantener los envíos desactivados.
# Recepción de notificaciones independiente de la activación de envíos.
BREVO_WEBHOOK_ENABLED=0
# Token aleatorio base64url (32–256 caracteres), distinto de otras claves.
BREVO_WEBHOOK_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contacto@casku.cl
BREVO_SENDER_NAME=Casku
BREVO_SENDER_VERIFIED=0
CASKU_MAIL_ENABLED=0
# Secreto aleatorio estable (mínimo 32 caracteres) para huellas de mensajes.
# No reutilizar AUTH_SECRET ni rotarlo sin revisar las entregas existentes.
CASKU_MAIL_DELIVERY_SECRET=

# Infraestructura de correos. Mantener desactivada hasta aprobar protocolo,
# calendario, plantillas e integración del proveedor. Nunca publicar estas claves.
CASKU_MAIL_AUTOMATION=0
CASKU_MAIL_POLICY_VERSION=
CASKU_MAIL_WORKER_SECRET=
# Obligatorio también para los envíos transaccionales y los webhooks.
# Secreto estable independiente del de autenticación: preserva la lista de supresión.
CASKU_MAIL_SUPPRESSION_SECRET=
