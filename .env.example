DATABASE_URL=postgresql://usuario:clave@localhost:5432/casku
AUTH_URL=http://localhost:3000
AUTH_SECRET=
CASKU_TEAM_ACCOUNTS=[]

# Brevo transaccional. Configuración privada; mantener los envíos desactivados.
# Recepción de notificaciones independiente de la activación de envíos.
BREVO_WEBHOOK_ENABLED=0
# Token aleatorio base64url (32–256 caracteres), distinto de otras claves.
BREVO_WEBHOOK_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contacto@casku.cl
BREVO_SENDER_NAME=Casku
BREVO_SENDER_VERIFIED=0
CASKU_MAIL_ENABLED=0
# Las pruebas con el proveedor real solo permiten estas direcciones exactas.
# Para activar el evento se requiere cambiar explícitamente a produccion.
CASKU_MAIL_MODE=pruebas
CASKU_MAIL_TEST_RECIPIENTS=
# Secreto aleatorio estable (mínimo 32 caracteres) para huellas de mensajes.
# No reutilizar AUTH_SECRET ni rotarlo sin revisar las entregas existentes.
CASKU_MAIL_DELIVERY_SECRET=

# Recuperación desacoplada. No activar hasta configurar el procesador privado.
CASKU_PASSWORD_RECOVERY_ENABLED=0
# Clave de 32 bytes aleatorios codificada en base64url (43 caracteres).
CASKU_PASSWORD_RECOVERY_QUEUE_KEY=
# Token base64url independiente (32–256 caracteres) del proceso privado.
CASKU_PASSWORD_RECOVERY_WORKER_SECRET=

# Infraestructura clínica. Mantener desactivada hasta aprobar protocolo,
# calendario y plantillas. Nunca publicar estas claves.
CASKU_MAIL_AUTOMATION=0
CASKU_MAIL_POLICY_VERSION=
CASKU_MAIL_WORKER_SECRET=
# Obligatorio también para los envíos transaccionales y los webhooks.
# Secreto estable independiente del de autenticación: preserva la lista de supresión.
CASKU_MAIL_SUPPRESSION_SECRET=

# Calendly: consulta administrativa de solo lectura. Token privado independiente.
CALENDLY_ENABLED=0
CALENDLY_API_TOKEN=

# Webhooks de Calendly: activar solo tras desplegar, crear y verificar la suscripción.
CALENDLY_WEBHOOK_ENABLED=0
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_WEBHOOK_SUBSCRIPTION_ID=
# Token independiente para las dos tareas privadas diarias de Vercel.
CRON_SECRET=
