# Plantilla sin credenciales. Completar en el hosting de pruebas o en un archivo privado.
# No copiar los datos reales de Casku a una base de ensayo.
AUTH_URL=https://REEMPLAZAR-ALOJAMIENTO.invalid
AUTH_TRUST_HOST=true
AUTH_SECRET=
DATABASE_URL=postgresql://usuario:clave@REEMPLAZAR-BASE.invalid/ensayo?sslmode=verify-full
CASKU_TEAM_ACCOUNTS=[]
CASKU_TEST_MODE=0
CASKU_PRODUCTION_TEST=0
CASKU_MAIL_ENABLED=0
CASKU_MAIL_MODE=pruebas
CASKU_MAIL_TEST_RECIPIENTS=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contacto@casku.cl
BREVO_SENDER_NAME=Casku
BREVO_SENDER_VERIFIED=0
CASKU_MAIL_DELIVERY_SECRET=
CASKU_MAIL_SUPPRESSION_SECRET=
BREVO_WEBHOOK_ENABLED=0
BREVO_WEBHOOK_SECRET=
CASKU_PASSWORD_RECOVERY_ENABLED=0
CASKU_PASSWORD_RECOVERY_QUEUE_KEY=
CASKU_PASSWORD_RECOVERY_WORKER_SECRET=
CASKU_MAIL_AUTOMATION=0
CALENDLY_ENABLED=0
CALENDLY_API_TOKEN=

# Solo Vercel: mantener vacío hasta preparar y activar el cron en el proyecto elegido.
CRON_SECRET=
