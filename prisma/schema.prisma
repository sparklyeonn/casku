generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CuentaEquipo {
  sesiones SesionEquipo[]
  id String @id
  email String @unique
  name String
  role String
  passwordHash String
  active Boolean @default(true)
  version Int @default(1)
  creadoPorId String?
  solicitudHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistroEquipo {
  id Int @id
  importadoAt DateTime?
}

model CambioCuentaEquipo {
  id String @id @default(uuid()) @db.Uuid
  cuentaId String
  actorId String
  accion String
  anterior Json?
  nueva Json
  createdAt DateTime @default(now())
  @@index([cuentaId, createdAt])
}

model Evento {
  autorizaciones AutorizacionPrivacidad[]
  ultimoOrdenEspera Int @default(0)
  listaEspera ListaEspera[]
  id             String                @id @default(uuid()) @db.Uuid
  nombre         String
  fecha          DateTime              @db.Date
  lugar          String
  cupos          Int
  creadoPorId    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  selecciones    EventoSeleccionado[]
  inscripcionesAbiertas Boolean @default(false)
  inscritos       Int @default(0)
  ultimoNumero    Int @default(0)
  inscripciones   Inscripcion[]
  ultimoOrdenFila Int @default(0)
  fila            EntradaFila[]
  llamadas        LlamadaFila[]
  previosConsecutivos Int @default(0)
  revision Int @default(1)
  cambios CambioEvento[]

  @@index([fecha, createdAt])
}

model CambioEvento {
  id String @id @default(uuid()) @db.Uuid
  eventoId String @db.Uuid
  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  revision Int
  actorId String
  anterior Json
  nueva Json
  createdAt DateTime @default(now())
  @@unique([eventoId, revision])
}

// Contexto de trabajo por cuenta. No activa ni cierra un evento globalmente.
model EventoSeleccionado {
  usuarioId String   @id
  eventoId  String   @db.Uuid
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([eventoId])
}

model Paciente {
  autorizaciones AutorizacionPrivacidad[]
  listaEspera ListaEspera[]
  revisionDatos Int @default(1)
  id              String       @id @default(cuid())
  rut             String?      @unique
  nombre          String
  fechaNacimiento DateTime
  createdAt       DateTime     @default(now())
  evaluaciones    Evaluacion[]
  apoderadoId     String?      @db.Uuid
  apoderado       Apoderado?   @relation(fields: [apoderadoId], references: [id], onDelete: Restrict)
  nombreNormalizado String?
  inscripciones   Inscripcion[]
  vinculaciones   VinculacionPresencial[]

  @@unique([apoderadoId, nombreNormalizado, fechaNacimiento])
}

model Evaluacion {
  autorizacionId String? @db.Uuid
  autorizacion AutorizacionPrivacidad? @relation(fields: [autorizacionId], references: [id], onDelete: Restrict)
  id              String   @id @default(cuid())
  pacienteId      String
  paciente        Paciente @relation(fields: [pacienteId], references: [id])
  correoPadre     String?
  anteroposterior Float
  biparietal      Float
  diagonalIzq     Float
  diagonalDer     Float
  indiceCraneal   Float
  indiceAsimetria Float
  diagnostico     String
  recomendacion   String
  kinesiologa     String
  createdAt       DateTime @default(now())
  filaId          String? @unique @db.Uuid
  fila            EntradaFila? @relation(fields: [filaId], references: [id], onDelete: Restrict)
  autorId         String?
  revision        Int @default(1)
  publicacion     ResultadoPublicado?
  revisiones      RevisionEvaluacion[]

  @@index([autorId, createdAt])
}

model Apoderado {
  autorizaciones AutorizacionPrivacidad[]
  listaEspera ListaEspera[]
  revisionDatos Int @default(1)
  id             String @id @default(uuid()) @db.Uuid
  correo         String @unique
  nombre         String?
  telefono       String?
  rut            String?
  activo         Boolean @default(true)
  versionSesion  Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bebes          Paciente[]
  inscripciones  Inscripcion[]
  resultados     ResultadoPublicado[]
  vinculaciones  VinculacionPresencial[]
}

model ResultadoPublicado {
  id              String @id @default(uuid()) @db.Uuid
  evaluacionId    String @unique
  evaluacion      Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)
  apoderadoId     String @db.Uuid
  apoderado       Apoderado @relation(fields: [apoderadoId], references: [id], onDelete: Restrict)
  publicadoPorId  String
  publicadoAt     DateTime @default(now())
  revision        Int
  datos           Json
  correo          CorreoResultado?

  @@index([apoderadoId, publicadoAt])
}

model RevisionEvaluacion {
  id            String @id @default(uuid()) @db.Uuid
  evaluacionId  String
  evaluacion    Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)
  revision      Int
  autorId       String
  anterior      Json
  nueva         Json
  createdAt     DateTime @default(now())

  @@unique([evaluacionId, revision])
}

model CorreoResultado {
  id             String @id @default(uuid()) @db.Uuid
  publicacionId  String @unique @db.Uuid
  publicacion    ResultadoPublicado @relation(fields: [publicacionId], references: [id], onDelete: Restrict)
  destinatario   String
  portalUrl      String?
  estado         EstadoCorreo @default(PENDIENTE)
  intentos       Int @default(0)
  disponibleAt   DateTime @default(now())
  bloqueoToken   String? @db.Uuid
  bloqueoHasta   DateTime?
  enviadoAt      DateTime?
  proveedorId    String?
  ultimoError    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([estado, disponibleAt])
}

model CodigoAccesoFamilia {
  correo           String @id
  desafioId        String @unique @db.Uuid
  codigoHash       String
  navegadorHash    String
  expiraAt         DateTime
  consumidoAt      DateTime?
  intentos         Int @default(0)
}

model LimiteSolicitud {
  clave     String @id
  cantidad  Int
  expiraAt  DateTime
  @@index([expiraAt])
}

model Inscripcion {
  autorizacionId String? @db.Uuid
  autorizacion AutorizacionPrivacidad? @relation(fields: [autorizacionId], references: [id], onDelete: Restrict)
  esperaOrigen ListaEspera?
  cancelacion CancelacionInscripcion?
  revisionContacto Int @default(1)
  id             String @id @db.Uuid
  solicitudHash  String
  eventoId       String @db.Uuid
  evento         Evento @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  pacienteId     String
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  apoderadoId    String? @db.Uuid
  apoderado      Apoderado? @relation(fields: [apoderadoId], references: [id], onDelete: Restrict)
  origen         OrigenInscripcion @default(PREVIA)
  contactoNombre String?
  contactoCorreo String?
  contactoTelefono String?
  registradoPorId String?
  numero         Int
  qrToken        String @unique
  createdAt      DateTime @default(now())
  correo         CorreoInscripcion?
  fila           EntradaFila?
  vinculaciones  VinculacionPresencial[]
  @@unique([id, eventoId])
  @@unique([eventoId, numero])
  @@unique([eventoId, pacienteId])
  @@index([apoderadoId, createdAt])
}

enum EstadoListaEspera {
  PENDIENTE
  ASIGNADA
  RETIRADA
  NO_ELEGIBLE
}

model ListaEspera {
  autorizacionId String? @db.Uuid
  autorizacion AutorizacionPrivacidad? @relation(fields: [autorizacionId], references: [id], onDelete: Restrict)
  id String @id @db.Uuid
  eventoId String @db.Uuid
  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  pacienteId String
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  apoderadoId String @db.Uuid
  apoderado Apoderado @relation(fields: [apoderadoId], references: [id], onDelete: Restrict)
  nombreBebe String
  orden Int
  estado EstadoListaEspera @default(PENDIENTE)
  solicitudHash String
  createdAt DateTime @default(now())
  resueltaAt DateTime?
  motivoResolucion String?
  origenResolucion String?
  inscripcionId String? @unique @db.Uuid
  inscripcion Inscripcion? @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  @@unique([eventoId, orden])
  @@index([eventoId, estado, orden])
  @@index([apoderadoId, createdAt])
}

model VinculacionPresencial {
  id             String @id @db.Uuid
  inscripcionId  String @db.Uuid
  inscripcion    Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  pacienteId     String
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  correo         String
  codigoHash     String @unique
  creadoPorId    String
  createdAt      DateTime @default(now())
  expiraAt       DateTime
  revocadaAt     DateTime?
  revocadaPorId  String?
  consumidaAt    DateTime?
  apoderadoId    String? @db.Uuid
  apoderado      Apoderado? @relation(fields: [apoderadoId], references: [id], onDelete: Restrict)

  @@index([inscripcionId, createdAt])
}

enum OrigenInscripcion {
  PREVIA
  PRESENCIAL
}

enum EstadoFila {
  EN_ESPERA
  EN_ATENCION
  ATENDIDO
  AUSENTE
  CANCELADO
}

model EntradaFila {
  id               String @id @default(uuid()) @db.Uuid
  eventoId         String @db.Uuid
  evento           Evento @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  inscripcionId    String @unique @db.Uuid
  inscripcion      Inscripcion @relation(fields: [inscripcionId, eventoId], references: [id, eventoId], onDelete: Restrict)
  orden            Int
  llegadaAt        DateTime @default(now())
  esperaDesde      DateTime @default(now())
  ausenciaId       String? @db.Uuid
  ausenteAt        DateTime?
  reincorporadaAt   DateTime?
  confirmadoPorId  String
  estado           EstadoFila @default(EN_ESPERA)
  profesionalId    String?
  reservaId        String? @db.Uuid
  llamadaAt        DateTime?
  finalizadaAt     DateTime?
  evaluacion       Evaluacion?
  llamadas         LlamadaFila[]
  movimientos      MovimientoFila[]

  @@unique([eventoId, orden])
  @@unique([inscripcionId, eventoId])
  @@index([eventoId, estado, orden])
  @@index([profesionalId, estado])
  @@index([eventoId, estado, esperaDesde, orden])
}

enum TipoMovimientoFila {
  AUSENCIA
  REINCORPORACION
}

model MovimientoFila {
  id           String @id @default(uuid()) @db.Uuid
  entradaId    String @db.Uuid
  entrada      EntradaFila @relation(fields: [entradaId], references: [id], onDelete: Restrict)
  ausenciaId   String @db.Uuid
  tipo         TipoMovimientoFila
  usuarioId    String
  createdAt    DateTime @default(now())

  @@unique([entradaId, ausenciaId, tipo])
  @@index([entradaId, createdAt])
}

// Guarda también respuestas de fila vacía y reintentos después de finalizar/devolver.
model LlamadaFila {
  id             String @id @db.Uuid
  profesionalId  String
  eventoId       String @db.Uuid
  evento         Evento @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  entradaId      String? @db.Uuid
  entrada        EntradaFila? @relation(fields: [entradaId], references: [id], onDelete: Restrict)
  reservaId      String? @db.Uuid
  createdAt      DateTime @default(now())
}

enum EstadoCorreo {
  PENDIENTE
  ENVIANDO
  ENVIADO
  FALLIDO
  CANCELADO
}

model CancelacionInscripcion {
  id String @id @default(uuid()) @db.Uuid
  inscripcionId String @unique @db.Uuid
  inscripcion Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  actorId String
  perfilActor String
  nombreActor String
  motivo String
  estadoFilaAnterior String?
  estadoCorreoAnterior String?
  createdAt DateTime @default(now())
}

model CorreoInscripcion {
  datosFamilia Json?
  revisionContenido Int @default(1)
  datosEvento   Json?
  id            String @id @default(uuid()) @db.Uuid
  inscripcionId String @unique @db.Uuid
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  estado        EstadoCorreo @default(PENDIENTE)
  intentos      Int @default(0)
  disponibleAt  DateTime @default(now())
  bloqueoToken  String? @db.Uuid
  bloqueoHasta  DateTime?
  enviadoAt     DateTime?
  proveedorId   String?
  ultimoError   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([estado, disponibleAt])
}

model CambioDatos {
  id String @id @default(uuid()) @db.Uuid
  entidad String
  registroId String
  revision Int
  actorId String
  perfilActor String
  apoderadoId String? @db.Uuid
  motivo String
  anterior Json
  nueva Json
  createdAt DateTime @default(now())
  @@unique([entidad, registroId, revision])
  @@index([apoderadoId, createdAt])
}


// El secreto de sesión solo viaja dentro del JWT cifrado; la base conserva su HMAC.
model SesionEquipo {
  id String @id @db.Uuid
  cuentaId String
  cuenta CuentaEquipo @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  secretoHash String @unique
  version Int
  createdAt DateTime @default(now())
  actividadAt DateTime @default(now())
  expiraAt DateTime
  revocadaAt DateTime?
  motivo String?
  @@index([cuentaId, createdAt])
  @@index([expiraAt])
}

model AutorizacionPrivacidad {
  id String @id @default(uuid()) @db.Uuid
  ambito String @unique
  pacienteId String
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  eventoId String? @db.Uuid
  evento Evento? @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  apoderadoId String? @db.Uuid
  apoderado Apoderado? @relation(fields: [apoderadoId], references: [id], onDelete: Restrict)
  datos Boolean
  correoResultados Boolean @default(false)
  seguimiento Boolean @default(false)
  revision Int @default(1)
  versionTexto String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inscripciones Inscripcion[]
  solicitudes ListaEspera[]
  evaluaciones Evaluacion[]
  cambios CambioPrivacidad[]
  @@index([apoderadoId, updatedAt])
}
model CambioPrivacidad {
  id String @id @default(uuid()) @db.Uuid
  autorizacionId String @db.Uuid
  autorizacion AutorizacionPrivacidad @relation(fields: [autorizacionId], references: [id], onDelete: Restrict)
  revision Int
  actorId String
  perfilActor String
  declarante String
  referencia String?
  canal String
  versionTexto String
  textos Json
  anterior Json?
  nueva Json
  createdAt DateTime @default(now())
  @@unique([autorizacionId, revision])
}
model AccesoPrivado {
  id String @id @default(uuid()) @db.Uuid
  actorId String
  perfilActor String
  accion String
  recurso String
  recursoId String
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@index([actorId, createdAt])
}
